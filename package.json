{
  "name": "vscode-agent",
  "displayName": "MiniMax Agent",
  "description": "Use the MiniMax Agent (Mavis) directly inside VSCode — chat, code actions, sessions, drive, and scheduled automations.\n\nConverse com o Mavis, aplique code actions, agende automações, direto no VSCode.",
  "version": "0.3.8",
  "publisher": "minimax",
  "license": "MIT",
  "homepage": "https://github.com/yuri-schmaltz/vscode-minimax-agent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuri-schmaltz/vscode-minimax-agent",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/yuri-schmaltz/vscode-minimax-agent/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Programming",
    "Chat",
    "Other"
  ],
  "keywords": [
    "mavis",
    "minimax",
    "agent",
    "ai",
    "code-actions",
    "chat",
    "drive",
    "cron"
  ],
  "main": "out/extension.js",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#7C3AED",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mavis.hello",
        "title": "Hello",
        "category": "Mavis"
      },
      {
        "command": "mavis.signIn",
        "title": "Sign in",
        "category": "Mavis"
      },
      {
        "command": "mavis.setApiKey",
        "title": "Set API key",
        "category": "Mavis"
      },
      {
        "command": "mavis.testConnection",
        "title": "Test connection",
        "category": "Mavis"
      },
      {
        "command": "mavis.welcome",
        "title": "Welcome",
        "category": "Mavis"
      },
      {
        "command": "mavis.signOut",
        "title": "Sign out",
        "category": "Mavis"
      },
      {
        "command": "mavis.newChat",
        "title": "New chat",
        "category": "Mavis"
      },
      {
        "command": "mavis.sendSelection",
        "title": "Send selection to chat",
        "category": "Mavis"
      },
      {
        "command": "mavis.toggleChat",
        "title": "Toggle chat",
        "category": "Mavis"
      },
      {
        "command": "mavis.openSettings",
        "title": "Open settings",
        "category": "Mavis"
      },
      {
        "command": "mavis.switchSession",
        "title": "Switch session",
        "category": "Mavis"
      },
      {
        "command": "mavis.switchAgent",
        "title": "Switch agent",
        "category": "Mavis"
      },
      {
        "command": "mavis.listSessions",
        "title": "List sessions",
        "category": "Mavis"
      },
      {
        "command": "mavis.listAgents",
        "title": "List agents",
        "category": "Mavis"
      },
      {
        "command": "mavis.refreshDrive",
        "title": "Refresh drive",
        "category": "Mavis",
        "icon": "$(refresh)"
      },
      {
        "command": "mavis.openDriveItem",
        "title": "Open drive item",
        "category": "Mavis"
      },
      {
        "command": "mavis.downloadDriveItem",
        "title": "Download drive item",
        "category": "Mavis"
      },
      {
        "command": "mavis.deleteDriveItem",
        "title": "Delete drive item",
        "category": "Mavis"
      },
      {
        "command": "mavis.attachToChat",
        "title": "Attach to chat",
        "category": "Mavis"
      },
      {
        "command": "mavis.scheduleCron",
        "title": "Schedule cron",
        "category": "Mavis"
      },
      {
        "command": "mavis.listCrons",
        "title": "List crons",
        "category": "Mavis"
      }
    ],
    "viewsContainers": {
      "auxiliarybar": [
        {
          "id": "mavis-side",
          "title": "MiniMax Agent",
          "icon": "resources/mavis-icon.svg"
        }
      ]
    },
    "views": {
      "mavis-side": [
        {
          "id": "mavis.chatView",
          "name": "Chat",
          "type": "webview",
          "contextualTitle": "MiniMax Agent",
          "when": "true"
        },
        {
          "id": "mavis.driveView",
          "name": "Drive",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mavis.refreshDrive",
          "when": "view == mavis.driveView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mavis.openDriveItem",
          "when": "view == mavis.driveView && viewItem == mavis.driveItem",
          "group": "open"
        },
        {
          "command": "mavis.downloadDriveItem",
          "when": "view == mavis.driveView && viewItem == mavis.driveItem",
          "group": "download"
        },
        {
          "command": "mavis.attachToChat",
          "when": "view == mavis.driveView && viewItem == mavis.driveItem",
          "group": "chat"
        },
        {
          "command": "mavis.deleteDriveItem",
          "when": "view == mavis.driveView && viewItem == mavis.driveItem",
          "group": "danger"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mavis.toggleChat",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "mavis.sendSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "mavis.switchSession",
        "key": "ctrl+shift+,",
        "mac": "cmd+shift+,"
      },
      {
        "command": "mavis.openSettings",
        "key": "ctrl+alt+,",
        "mac": "cmd+alt+,",
        "when": "editorTextFocus || workbench.focus.activeContainerHasMavisProvider"
      }
    ],
    "notebookProvider": [
      {
        "viewType": "mavis-notebook",
        "displayName": "Mavis Notebook",
        "filenamePattern": [
          "*.mavisnb",
          "*.mavis.ipynb"
        ],
        "exclusive": false,
        "priority": "default"
      }
    ],
    "taskDefinitions": [
      {
        "type": "mavis",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "npm script to run (e.g. test, lint, package)."
          },
          "label": {
            "type": "string",
            "description": "Optional override for the displayed task label."
          }
        }
      }
    ],
    "languages": [
      {
        "id": "mavis-notebook",
        "aliases": [
          "Mavis Notebook",
          "mavisnb"
        ],
        "filenamePatterns": [
          "*.mavisnb"
        ]
      }
    ],
    "configuration": {
      "title": "MiniMax Agent",
      "type": "object",
      "properties": {
        "mavis.defaultAgent": {
          "type": "string",
          "default": "mavis",
          "markdownDescription": "Which agent to spawn by default when starting a new chat."
        },
        "mavis.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override path to the `mavis` CLI binary. If empty, uses the bundled shim."
        },
        "mavis.cliVersion": {
          "type": "string",
          "default": "",
          "markdownDescription": "Bundled CLI version (shown in the status bar and settings UI). Defaults to the bundled shim's `package.json` version."
        },
        "mavis.model": {
          "type": "string",
          "default": "MiniMax-M3",
          "markdownDescription": "Model used for completions. Default: `MiniMax-M3` (MiniMax's flagship M3 model)."
        },
        "mavis.telemetry": {
          "type": "string",
          "enum": [
            "false",
            "true",
            "ask-once"
          ],
          "enumDescriptions": [
            "No events are ever sent.",
            "Send anonymous usage events (command id, message length, code-action kind, cron id — no content).",
            "Show the one-time opt-in notice; never ask again after the user answers."
          ],
          "default": "false",
          "markdownDescription": "Opt-in anonymous usage telemetry. **Default: off** — no events are collected unless you explicitly enable this or accept the one-time opt-in notice."
        },
        "mavis.oauthFlow": {
          "type": "string",
          "enum": [
            "auto",
            "deviceCode",
            "pkce"
          ],
          "default": "auto",
          "markdownDescription": "OAuth flow to use for sign-in. `auto` probes `/.well-known/oauth-config.json` first; falls back to device-code."
        },
        "mavis.archonUrl": {
          "type": "string",
          "default": "https://api.minimax.io",
          "markdownDescription": "Base URL for the Mavis (MiniMax) backend. **Default: `https://api.minimax.io`** — the public MiniMax API. Override only if you self-host the archon-server."
        },
        "mavis.apiBase": {
          "type": "string",
          "default": "/v1",
          "markdownDescription": "Path prefix appended to `mavis.archonUrl` for chat/completions calls. Default: `/v1` (OpenAI-compatible)."
        },
        "mavis.stream": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable SSE streaming for chat responses. **Default: off** — the shim uses non-streaming for reliability; the response arrives all at once after a few seconds. Turn on to get the word-by-word typing effect, but the SSE parser is still rough around the edges."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "npm run build && vsce package",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx --import ./test/helpers/registerVscodeMock.cjs $(find test src -name '*.test.ts' | tr '\\n' ' ')",
    "test:coverage": "c8 --reporter=text --reporter=text-summary --check-coverage --lines=60 --branches=60 --functions=80 --statements=60 --include='src/**/*.ts' npm test",
    "test:e2e": "npm run package && node -e \"require('./test/e2e/extension.test.js').go().catch(e => { console.error(e); process.exit(1); })\"",
    "lint:secrets": "node scripts/check-secrets.cjs",
    "pretest": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "shiki": "^1.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/vsce": "^2.32.0",
    "c8": "^10.1.3",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
